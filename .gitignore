# ---- Terraform ----
# Downloaded provider plugins & modules (huge; re-fetched by `terraform init`)
**/.terraform/*

# State files: contain secrets in plaintext — never commit
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Variable files that may hold secrets
*.tfvars
*.tfvars.json

# CLI config & plan output
.terraformrc
terraform.rc
*.tfplan

# NOTE: .terraform.lock.hcl SHOULD be committed (locks provider versions),
# so it is intentionally not ignored here.

# ---- Node ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Env / secrets ----
.env
.env.*
!.env.example

# ---- OS / editor ----
.DS_Store
Thumbs.db
